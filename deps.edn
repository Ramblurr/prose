{:paths ["src/main" "resources"]

 :deps {org.babashka/sci     {:mvn/version "0.3.32"}
        meander/epsilon      {:mvn/version "0.0.650"}
        medley/medley        {:mvn/version "1.4.0"}
        net.cgrand/macrovich {:mvn/version "0.2.1"}
        com.hyperfiddle/rcf  {:mvn/version "20220902-130636"}}

 :aliases {:clj {:extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}

           :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.134"}}}

           :dev {:extra-paths ["src/dev"]}

           :nrepl  {:extra-deps {nrepl/nrepl      {:mvn/version "1.7.0"}}}

           :piggie {:extra-deps {cider/piggieback {:mvn/version "0.7.0"}}}

           :test {:extra-paths ["src/test" "test-resources"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               com.lambdaisland/kaocha-cljs {:mvn/version "1.9.181"}}}

           :package {:extra-paths ["src/build"]
                     :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                     :ns-default prose.build}

           :build {:extra-paths ["src/build" "src/docs"]
                   :extra-deps {io.github.jerems/mbt2  {:git/tag "v18"
                                                        :git/sha "7ab4748b43"
                                                        :exclusions [io.github.jerems/prose]}
                                io.github.jerems/clj-nio {:git/tag "v72", :git/sha "f8d301953d"}}}}}

