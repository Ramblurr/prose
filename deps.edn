{:paths ["src/main" "resources/main"]

 :deps {org.babashka/sci     {:mvn/version "0.3.32"}
        meander/epsilon      {:mvn/version "0.0.650"}
        medley/medley        {:mvn/version "1.4.0"}
        net.cgrand/macrovich {:mvn/version "0.2.1"}}

 :aliases {:dev {:extra-paths ["src/dev" "src/docs"]
                 :extra-deps {org.clojure/clojure       {:mvn/version "1.12.5"}
                              org.clojure/clojurescript {:mvn/version "1.12.134"}
                              nrepl/nrepl               {:mvn/version "1.7.0"}
                              cider/piggieback          {:mvn/version "0.7.0"}}}

           :test {:extra-paths ["src/test" "resources/test"]
                  :extra-deps {lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                               com.lambdaisland/kaocha-cljs {:mvn/version "1.9.181"}}}

           :build {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                   :ns-default build}}}

